{
  "schema": "halide-seccomp-v1",
  "bridge": "audio",
  "default_action": "SCMP_ACT_ERRNO",
  "notes": "Audio proxy socket client (sepolicy-deltas S3 halide_audio row). execve + ptrace denied.",
  "syscalls": [
    {"names": ["read", "write", "recvmsg", "sendmsg", "poll", "epoll_wait", "epoll_ctl"], "action": "SCMP_ACT_ALLOW", "reason": "event-loop + proxy socket IO"},
    {"names": ["ioctl"], "action": "SCMP_ACT_ALLOW", "reason": "PCM node ioctl only (node allowlist in AppArmor/sepolicy)"},
    {"names": ["openat", "close", "fstat", "mmap", "munmap"], "action": "SCMP_ACT_ALLOW", "reason": "minimal runtime linkage, no exec"},
    {"names": ["futex", "nanosleep", "clock_gettime", "getpid", "gettid"], "action": "SCMP_ACT_ALLOW", "reason": "threading + xruns timers"},
    {"names": ["execve", "execveat", "ptrace", "process_vm_writev"], "action": "SCMP_ACT_ERRNO", "reason": "RCE containment (binding)"}
  ]
}
